#!/bin/busybox sh
# Test initramfs: report the command line and the display state on serial, keep the
# frame up for a moment so the harness can capture it, then power off.
/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
exec >/dev/ttyS0 2>&1
echo "INIT_CMDLINE: $(cat /proc/cmdline)"
echo "INIT_FB: $(cat /proc/fb | tr '\n' ';')"
echo "INIT_DRM: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"
echo "INIT_VTCON: $(for v in /sys/class/vtconsole/*; do echo -n "$(cat $v/name)=$(cat $v/bind) "; done)"
echo "INIT_READY"
sleep 3
echo "INIT_POWEROFF"
poweroff -f
